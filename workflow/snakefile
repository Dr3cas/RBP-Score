configfile: "config/config.yaml"

from pathlib import Path


def sanitize_id(qid):
    return qid.replace("|", "_").replace("/", "_").replace("\\", "_").replace(" ", "_")


def get_query_ids():
    query_file = Path("data/query_clean.fasta")
    if not query_file.exists():
        query_file = Path("data/query.fasta")

    ids = []

    with open(query_file) as f:
        for line in f:
            if line.startswith(">"):
                header = line[1:].strip().replace(" ", "_").split()[0]
                parts = header.split("|")

                parts_no_label = [
                    p for p in parts
                    if not p.lower().startswith("label=")
                ]

                qid = "|".join(parts_no_label)
                qid = qid.replace("unknow_", "unknown_")
                ids.append(sanitize_id(qid))

    return ids


QUERY_IDS = get_query_ids()


rule all:
    input:
        "data/rbp_db_annotated.fasta",
        "data/query_clean.fasta",
        "results/blast_results.tsv",
        expand("results/query_fastas/{query}.fasta", query=QUERY_IDS),
        "results/phylogeny/outgroup.validated.txt",
        "results/phylogeny/global_phylogeny_input.fasta",
        "results/alignments/global_alignment.fasta",
        "results/trees/global_tree_unrooted.nwk",
        "results/trees/global_tree_rooted.nwk",
        "results/trees_png/global_tree_rooted.png",
        "results/query_structures/query_pdb_summary.tsv",
        "results/foldseek/foldseek_structural_results.tsv",
        "results/rbpscore/final_rbpscore_summary.tsv",
        "results/rbpscore/detailed_rbpscore.tsv",
        expand("results/rbpscore/details/{query}.details.tsv", query=QUERY_IDS)


rule build_rbp_db_with_morphotype:
    input:
        excel="data/RBP_validated_final.xlsx",
        outgroup="data/outgroup.fasta"
    output:
        fasta="data/rbp_db_annotated.fasta",
        blast_fasta="data/blast_db_with_outgroups.fasta",
        metadata="results/database/rbp_db_metadata.tsv"
    shell:
        """
        python3 scripts/build_rbp_db_with_morphotype.py \
            --excel {input.excel} \
            --outgroup {input.outgroup} \
            --output {output.fasta} \
            --blast-output {output.blast_fasta} \
            --metadata {output.metadata}
        """



rule clean_query_fasta:
    input:
        "data/query.fasta"
    output:
        "data/query_clean.fasta"
    shell:
        """
        python3 scripts/clean_query_fasta.py {input} {output}
        """

rule makeblastdb:
    input:
        fasta="data/blast_db_with_outgroups.fasta"
    output:
        "db/rbp_db.pin",
        "db/rbp_db.psq",
        "db/rbp_db.phr"
    shell:
        """
        mkdir -p db
        makeblastdb -in {input.fasta} -dbtype prot -out db/rbp_db
        """

rule blastp:
    input:
        query="data/query_clean.fasta",
        db="db/rbp_db.pin"
    output:
        "results/blast_results.tsv"
    threads: 4
    shell:
        """
        mkdir -p results

        echo -e "qseqid\\tsseqid\\tpident\\tlength\\tmismatch\\tgapopen\\tqstart\\tqend\\tsstart\\tsend\\tevalue\\tbitscore\\tqlen" > {output}

        blastp \
            -query {input.query} \
            -db db/rbp_db \
            -out results/blast_results.tmp.tsv \
            -outfmt "6 qseqid sseqid pident length mismatch gapopen qstart qend sstart send evalue bitscore qlen" \
            -evalue 1000 \
            -max_target_seqs 10000 \
            -max_hsps 1 \
            -seg yes \
            -soft_masking true \
            -num_threads {threads}

        cat results/blast_results.tmp.tsv >> {output}
        rm -f results/blast_results.tmp.tsv
        """


