        """

rule predict_query_structures:
    input:
        expand("results/query_fastas/{query}.fasta", query=QUERY_IDS),
        tree_png="results/trees_png/global_tree_rooted.png",
    output:
        summary="results/query_structures/query_pdb_summary.tsv"
    threads: 4
    shell:
        """
        python3 scripts/run_colabfold_clean_queries.py \
            --gpu {config[colabfold][gpu]} \
            --input-dir results/query_fastas \
            --raw-dir results/query_structures_raw \
            --pdb-dir results/query_structures \
            --logs-dir logs/colabfold_queries \
            --summary {output.summary} \
            --num-models {config[colabfold][num_models]} \
            --num-recycle {config[colabfold][num_recycle]} \
            --msa-mode {config[colabfold][msa_mode]}
        """

rule foldseek_structural_search:
    input:
        query_summary="results/query_structures/query_pdb_summary.tsv"
    output:
        "results/foldseek/foldseek_structural_results.tsv"
    threads: 4
    shell:
        """
        mkdir -p results/foldseek
        rm -rf results/foldseek/tmp

        echo -e "query\\ttarget\\tevalue\\tbits\\talntmscore\\tqtmscore\\tttmscore\\trmsd" > results/foldseek/foldseek_structural_results.tsv

        foldseek easy-search \
            results/query_structures \
            reference_structures/pdb \
            results/foldseek/foldseek_tmp.tsv \
            results/foldseek/tmp \
            --alignment-type {config[foldseek][alignment_type]} \
            -e {config[foldseek][evalue]} \
            --max-seqs {config[foldseek][max_seqs]} \
            --format-output "query,target,evalue,bits,alntmscore,qtmscore,ttmscore,rmsd"

        cat results/foldseek/foldseek_tmp.tsv >> results/foldseek/foldseek_structural_results.tsv

        rm -f results/foldseek/foldseek_tmp.tsv
        rm -rf results/foldseek/tmp
        """


rule calculate_rbpscore:
    input:
        blast="results/blast_results.tsv",
        query="data/query_clean.fasta",
        db="data/rbp_db_annotated.fasta",
        tree="results/trees/global_tree_rooted.nwk",
        foldseek="results/foldseek/foldseek_structural_results.tsv",
        outgroup="data/outgroup.fasta"
    output:
        summary="results/rbpscore/final_rbpscore_summary.tsv",
        detailed="results/rbpscore/detailed_rbpscore.tsv",
        details=expand("results/rbpscore/details/{query}.details.tsv", query=QUERY_IDS)
    shell:
        """
        python3 scripts/calculate_rbpscore.py \
            --blast {input.blast} \
            --query {input.query} \
            --db {input.db} \
            --tree {input.tree} \
            --foldseek {input.foldseek} \
            --outgroup {input.outgroup} \
            --summary {output.summary} \
            --detailed {output.detailed} \
            --details-dir results/rbpscore/details \
            --config config/config.yaml
        """
